{
  "name": "lyric-syntax",
  "displayName": "Lyric Syntax Highlighting",
  "description": "Syntax highlighting and language support for the Lyric programming language.",
  "version": "0.3.1",
  "publisher": "aeonath",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "lyric",
        "aliases": ["Lyric", "lyric"],
        "extensions": [".ly"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lyric",
        "scopeName": "source.lyric",
        "path": "./syntaxes/lyric.tmLanguage.json"
      }
    ]
  }
}

