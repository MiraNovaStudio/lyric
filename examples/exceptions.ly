# Error handling in Lyric

def flt divide(int a, int b) {
  if b == 0:
    raise "Division by zero"
  end
  return a / b
}

def main() {}
  try:
    flt result = divide(10, 0)
    print("Result:", result)
  catch:
    print("An error occurred while dividing numbers.")
  finally:
    print("Operation finished.")
  fade

  x = 12

