# This is a comprehensive comment test
# Multiple comment lines
# Testing various comment scenarios

def main() {
    # Function-level comment
    print("Testing comments") # Inline comment
    
    # Another comment
    x = 5 # Assignment with comment
    
    # Conditional with comment
    if x > 3: # Condition comment
        print("x is greater than 3") # True branch comment
    else:
        print("x is not greater than 3") # False branch comment
    end
    
    # Loop with comment
    given i in range(3): # Loop comment
        print("Iteration:", i) # Loop body comment
    done
}
