def main() {
    arr fruits = ["apple", "banana", "cherry"]

    if "banana" in fruits
        print("Found it!")
    end

    map person = {"name": "Alice", "age": 30}

    if "name" in person
        print(person["name"])
    end

    str text = "Hello, World!"

    if "World" in text
        print("World is in there")
    end
}
