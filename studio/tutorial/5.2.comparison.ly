def main() {
    int x = 5
    int y = 10

    print(x == y)   # False — equal to
    print(x != y)   # True  — not equal
    print(x < y)    # True  — less than
    print(x <= 5)   # True  — less than or equal
    print(y > x)    # True  — greater than
    print(y >= 10)  # True  — greater than or equal
}
