importpy math

def main() {
    flt root = math.sqrt(16)
    print("Square root of 16:", root)

    print("Pi:", math.pi)
    print("floor(3.7) — rounds down:", math.floor(3.7))
    print("ceil(3.2) — rounds up:", math.ceil(3.2))

    flt angle = math.pi / 4
    print("sin(π/4):", math.sin(angle))
    print("cos(π/4):", math.cos(angle))
}
